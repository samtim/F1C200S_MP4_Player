diff --git a/drivers/gpu/drm/panel/panel-simple.c b/drivers/gpu/drm/panel/panel-simple.c
index 17e1aaa70..1ae25e9b3 100644
--- a/drivers/gpu/drm/panel/panel-simple.c
+++ b/drivers/gpu/drm/panel/panel-simple.c
@@ -1466,6 +1466,42 @@ static const struct drm_display_mode avic_tm070ddh03_mode = {
 	.vtotal = 600 + 17 + 1 + 17,
 };
 
+/*
+ * BI50LA7002-27CD, 7" 1024x600 TTL panel (Shenzhen Bochuangda).
+ * Timing taken from the panel datasheet rev V0, section 6.2:
+ *   clock 51.2 MHz typ, Tht 1344, THFP 160, THBP 160, THS 24        (HS inside THBP)
+ *   Tvt 635, TVFP 12, TVBP 23, TVS 2                                (VS inside TVBP)
+ * MODE pin is normally high  -> DE mode, HS/VS unused.
+ * Data is latched on the falling DCLK edge -> TCON drives on rising edge.
+ */
+static const struct drm_display_mode liulianpi_lcd1024x600_mode = {
+	.clock = 51200,
+	.hdisplay = 1024,
+	.hsync_start = 1024 + 160,      /* THFP  = 160 */
+	.hsync_end = 1024 + 160 + 24,   /* THS   = 24  */
+	.htotal = 1344,                 /* THFP + THBP(160) + active */
+	.vdisplay = 600,
+	.vsync_start = 600 + 12,        /* TVFP  = 12  */
+	.vsync_end = 600 + 12 + 2,      /* TVS   = 2   */
+	.vtotal = 635,                  /* 51.2MHz / (1344*635) = 60.00 Hz */
+	.flags = DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_PVSYNC,
+};
+
+static const struct panel_desc liulianpi_lcd1024x600 = {
+	.modes = &liulianpi_lcd1024x600_mode,
+	.num_modes = 1,
+	.bpc = 8,
+	.size = {
+		.width = 154,
+		.height = 90,
+	},
+	.delay = {
+		.prepare = 20,
+		.enable = 200,
+		.disable = 200,
+	},
+};
+
 static const struct panel_desc avic_tm070ddh03 = {
 	.modes = &avic_tm070ddh03_mode,
 	.num_modes = 1,
@@ -4582,6 +4618,9 @@ static const struct of_device_id platform_of_match[] = {
 	}, {
 		.compatible = "avic,tm070ddh03",
 		.data = &avic_tm070ddh03,
+	}, {
+		.compatible = "liulianpi,lcd1024x600",
+		.data = &liulianpi_lcd1024x600,
 	}, {
 		.compatible = "bananapi,s070wv20-ct16",
 		.data = &bananapi_s070wv20_ct16,
