 	DRM_DEBUG_DRIVER("Layer line width: %d bits\n", fb->pitches[0] * 8);
 	regmap_write(backend->engine.regs, SUN4I_BACKEND_IYUVLINEWIDTH_REG(0),
diff --git a/drivers/gpu/drm/sun4i/sun4i_drv.c b/drivers/gpu/drm/sun4i/sun4i_drv.c
index 0cc64c973..2c389f53b 100644
--- a/drivers/gpu/drm/sun4i/sun4i_drv.c
+++ b/drivers/gpu/drm/sun4i/sun4i_drv.c
@@ -110,7 +110,10 @@ static int sun4i_drv_bind(struct device *dev)
 	if (ret)
 		goto finish_poll;
 
-	drm_fbdev_generic_setup(drm, 32);
+	/* 16bpp (RGB565) instead of 32bpp: the fbdev framebuffer is written by
+	 * the CPU on every video frame, so halving the bytes per pixel is a
+	 * direct win on this memory-bandwidth-bound board. */
+	drm_fbdev_generic_setup(drm, 16);
 
 	dev_set_drvdata(dev, drm);
 
