# Target: LiuLianPi F1C100s/F1C200S (arm926ej-s, soft float, musl)
# musl is required: the only ARMv5TE/soft-float builds of the Allwinner
# CedarX H.264 decoder (libawh264.so) that ship with libcedarc are musl ones.
BR2_arm=y
BR2_arm926t=y
BR2_ARM_EABI=y
BR2_SOFT_FLOAT=y

BR2_TOOLCHAIN_BUILDROOT=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_LIBC="musl"
BR2_KERNEL_HEADERS_5_15=y

BR2_TARGET_GENERIC_HOSTNAME="liulianpi"
BR2_TARGET_GENERIC_ISSUE="Welcome to LiuLianPi F1C100S/F1C200S"
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y

BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y

BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_LRZSZ=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA_CLIENT_SOFTWARE=y
BR2_PACKAGE_IW=y

BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_LIB_MIXER=y
BR2_PACKAGE_ALSA_LIB_PCM=y
BR2_PACKAGE_FAAD2=y
BR2_PACKAGE_LIBDRM=y

BR2_TARGET_ROOTFS_TAR=y
